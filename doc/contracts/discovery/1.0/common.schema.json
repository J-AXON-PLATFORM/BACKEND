{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.j-axon.invalid/discovery/1.0/common.schema.json",
  "title": "J-AXON Discovery common definitions 1.0",
  "type": "object",
  "$defs": {
    "uuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "canonicalCidr": {
      "type": "string",
      "format": "cidr",
      "minLength": 3,
      "maxLength": 43,
      "pattern": "^[0-9a-f:.]+/(?:0|[1-9][0-9]{0,2})$"
    }
  },
  "additionalProperties": false
}
