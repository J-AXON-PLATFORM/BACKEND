JAXON_ENVIRONMENT=local
JAXON_DB_NAME=jaxon_local
JAXON_DB_USERNAME=jaxon_local
JAXON_DB_PASSWORD=local-only-example-password
JAXON_DB_URL=jdbc:postgresql://127.0.0.1:5432/jaxon_local
JAXON_DB_HOST_PORT=5432
JAXON_BACKEND_HOST_PORT=8080
JAXON_SFTPGO_IMAGE=jaxon-sftpgo:2.7.6-local
JAXON_SFTPGO_ADMIN_USERNAME=jaxon-local-provisioner
JAXON_SFTPGO_ADMIN_PASSWORD=local-only-example-sftpgo-password
JAXON_SFTP_ENABLED=false
JAXON_SFTP_HOST_PORT=2022
JAXON_SFTP_PUBLIC_HOST=127.0.0.1
JAXON_SFTP_PUBLIC_PORT=2022
JAXON_SFTP_PUBLIC_HOST_KEY=
JAXON_COLLECTOR_RECONCILIATION_INTERVAL=5m
JAXON_COLLECTOR_SNAPSHOT_STABILITY_AGE=2s
JAXON_COLLECTOR_SNAPSHOT_BATCH_SIZE=100
JAXON_FRONTEND_ORIGIN=http://localhost:3000
JAXON_IDENTITY_BOOTSTRAP_ENABLED=false
JAXON_IDENTITY_BOOTSTRAP_USERNAME=
JAXON_IDENTITY_BOOTSTRAP_PASSWORD=
JAXON_LOG_FORMAT=logstash
JAXON_TRACING_SAMPLING_PROBABILITY=0.10
JAXON_TRACING_EXPORT_OTLP_ENABLED=false
JAXON_TRACING_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
JAXON_TRACING_OTLP_TIMEOUT=5s
